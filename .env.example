# Workspace behavior
DEFAULT_DATA_MODE=mock
DATA_MODE_LOCKED=0
# Production: supabase. Supported alternatives: entra, aws-alb.
AUTH_MODE=supabase
# Exact browser-facing origin used for auth redirects and email callbacks.
AUTH_PUBLIC_ORIGIN=https://freyrsales.dev.freyrapps.com
MARKET_INTEL_AUTO_COLLECTION_ENABLED=0
# Supabase signup accepts any valid email only when a pending, unexpired
# workspace invitation exists. This setting keeps approval explicit for
# Entra/AWS modes as well.
ACCESS_CONTROL_MODE=approval
# One random 32+ character secret signs both login and workspace-access cookies.
AUTH_COOKIE_SECRET=
OWNER_EMAILS=
FREYR_WORKSPACE_ID=
FREYR_WORKSPACE_NAME=Freyr Sales

# AI and enrichment providers (used only when clean/live mode is active)
ANTHROPIC_API_KEY=
# Agent provider. Keep anthropic until Vertex credentials pass `npm run vertex:verify`.
AGENT_PROVIDER=anthropic
# Vertex AI uses Google Application Default Credentials. Production should use
# AWS Workload Identity Federation, not a downloaded service-account key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
VERTEX_AI_MODEL=gemini-3.5-flash
VERTEX_VERIFY_ON_STARTUP=0
# Local-only ADC/WIF credential configuration path when one is required.
GOOGLE_APPLICATION_CREDENTIALS=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

# Durable PostgreSQL/Supabase adapter
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional delivery channels
RESEND_API_KEY=
EMAIL_FROM=
# Feedback reports are saved and sent here with the automatic screenshot attached.
FEEDBACK_RECIPIENT_EMAIL=anir@auctalai.com
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Set this as an x-freyr-voice-secret custom header on the ElevenLabs inbound
# personalization webhook. It is separate from post-call HMAC verification.
ELEVENLABS_INBOUND_WEBHOOK_SECRET=
FREYR_VOICE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
