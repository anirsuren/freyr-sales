{
  "name": "freyr-sales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "test:smoke": "playwright test tests/smoke.spec.ts --reporter=list",
    "test:auth": "playwright test tests/auth.spec.ts --config=playwright.auth.config.ts --reporter=list",
    "test:onboarding": "playwright test tests/onboarding.spec.ts --config=playwright.onboarding.config.ts --reporter=list",
    "test:real": "playwright test tests/real-mode.spec.ts --config=playwright.real.config.ts --reporter=list",
    "test:e2e": "playwright test tests/verify.spec.ts --reporter=list",
    "test:folder-upload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/material-folder-upload.test.mjs",
    "test:content-agent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/content-agent.test.mjs",
    "test:rules": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/aug25-rules.test.mjs",
    "live": "curl -sS -X POST localhost:3001/api/settings/data-mode -H 'content-type: application/json' -d '{\"mode\":\"live\"}'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-sesv2": "^3.1117.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/supabase-js": "^2.108.2",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.4.0",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.21",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "pptx-preview": "^1.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "eslint": {
      "brace-expansion": "1.1.18"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "readdir-glob": {
      "brace-expansion": "2.1.4"
    },
    "pptx-preview": {
      "echarts": "6.1.0",
      "uuid": "11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
